<div class="brand-row">
    <a class="brand" href="" aria-label="My Quest home">
        <span class="brand__mark" aria-hidden="true">★</span>
        <span><strong>My Quest</strong><small>Plan. Focus. Achieve.</small></span>
    </a>
    <input id="quest-nav-toggle" type="checkbox" title="Navigation menu" class="navbar-toggler" />
    <label class="navbar-toggler-label" for="quest-nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
    </label>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 14a8 8 0 1 1 16 0"></path><path d="M12 14l4-5"></path><path d="M5 18h14"></path></svg>
                Dashboard
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="tasks">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"></rect><path d="M9 4V2m6 2V2M9 9h6m-6 4h6m-6 4h4"></path></svg>
                        My Tasks
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="tasks?filter=completed">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16 9"></path></svg>
                        Completed
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="profile">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"></circle><path d="M6 21v-2a6 6 0 0 1 12 0v2"></path></svg>
                        Profile
                    </NavLink>
                </div>
                <div class="nav-item">
                    <a class="nav-link" href="logout">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg>
                        Sign out
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="login">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><path d="M10 17l5-5-5-5"></path><path d="M15 12H3"></path></svg>
                        Sign In
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="register">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M19 8v6M22 11h-6"></path></svg>
                        Create Account
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<AuthorizeView>
    <Authorized>
        <a class="profile-card" href="profile">
            <span class="avatar">@Initials(context.User.FindFirst("FullName")?.Value ?? context.User.Identity?.Name)<i aria-hidden="true"></i></span>
            <span class="profile-card__copy">
                <strong>@(context.User.FindFirst("FullName")?.Value ?? context.User.Identity?.Name)</strong>
                <small>@context.User.Identity?.Name</small>
            </span>
        </a>
    </Authorized>
</AuthorizeView>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
