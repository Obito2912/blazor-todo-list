@page "/tasks"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager Navigation
@inject ITaskService TaskService
@using System.Security.Claims

<PageTitle>My Tasks | My Quest</PageTitle>

<section class="task-page" aria-labelledby="task-list-heading">
    <h1 id="task-list-heading">My Tasks</h1>

    <div class="task-toolbar">
        <SearchBar @bind-Value="searchTerm" />
        <FilterDropDown @bind-Value="selectedFilter" />
        <a class="btn-quest-primary" href="tasks/new">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"></path></svg>
            Add Task
        </a>
    </div>

    @if (isLoading)
    {
        <div class="task-state" role="status" aria-live="polite">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
            <span>Loading tasks…</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Tasks could not be loaded.</strong>
            <span>@errorMessage</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadTasksAsync">Try again</button>
        </div>
    }
    else if (FilteredTasks.Count == 0)
    {
        <div class="task-state task-state--empty">
            <h2>@EmptyStateTitle</h2>
            <p>@EmptyStateMessage</p>
            @if (tasks.Count == 0)
            {
                <a class="btn btn-primary" href="tasks/new">Add a task</a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">Clear filters</button>
            }
        </div>
    }
    else
    {
        <div class="task-list" aria-live="polite">
            @foreach (var task in FilteredTasks)
            {
                <TaskCard @key="task.Id"
                          Title="@task.Title"
                          Description="@task.Description"
                          IsCompleted="@task.IsCompleted"
                          DueDate="@task.DueDate"
                          CompletionChanged="completed => SetCompletionAsync(task.Id, completed)"
                          OnEdit="() => EditTask(task.Id)"
                          OnDelete="() => DeleteTaskAsync(task.Id)" />
            }
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "filter")]
    private string? FilterQuery { get; set; }

    private string searchTerm = string.Empty;
    private TaskFilter selectedFilter = TaskFilter.All;
    private IReadOnlyList<TaskListItem> tasks = [];
    private bool isLoading = true;
    private string? errorMessage;
    private string? userId;

    private IReadOnlyList<TaskListItem> FilteredTasks => tasks
        .Where(task => string.IsNullOrWhiteSpace(searchTerm)
            || task.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (task.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(task => selectedFilter switch
        {
            TaskFilter.Completed => task.IsCompleted,
            TaskFilter.Pending => !task.IsCompleted,
            _ => true
        })
        .ToList();

    private string EmptyStateTitle => tasks.Count == 0 ? "No tasks yet" : "No matching tasks";
    private string EmptyStateMessage => tasks.Count == 0
        ? "Add your first task to begin your quest."
        : "Try another search or status filter.";

    protected override async Task OnParametersSetAsync()
    {
        selectedFilter = Enum.TryParse<TaskFilter>(FilterQuery, true, out var filter) ? filter : TaskFilter.All;
        if (userId is null)
        {
            await LoadTasksAsync();
        }
    }

    private async Task LoadTasksAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (AuthenticationStateTask is null)
            {
                throw new InvalidOperationException("Authentication state is unavailable.");
            }

            var state = await AuthenticationStateTask;
            userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                throw new InvalidOperationException("The signed-in user could not be identified.");
            }

            var taskItems = await TaskService.GetTasksAsync(userId);
            tasks = taskItems.Select(ToListItem).ToList();
        }
        catch (Exception)
        {
            errorMessage = "Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetCompletionAsync(int id, bool completed)
    {
        if (userId is null || !await TaskService.SetCompletionAsync(id, completed, userId))
        {
            errorMessage = "The task could not be updated.";
            return;
        }

        tasks = tasks.Select(task => task.Id == id ? task with { IsCompleted = completed } : task).ToList();
    }

    private async Task DeleteTaskAsync(int id)
    {
        if (userId is null || !await TaskService.DeleteTaskAsync(id, userId))
        {
            errorMessage = "The task could not be deleted.";
            return;
        }

        tasks = tasks.Where(task => task.Id != id).ToList();
    }

    private void EditTask(int id) => Navigation.NavigateTo($"tasks/new?edit={id}");

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedFilter = TaskFilter.All;
    }

    private static TaskListItem ToListItem(TaskItem task) =>
        new(task.Id, task.Title, task.Description, task.IsCompleted, task.DueDate);
}
