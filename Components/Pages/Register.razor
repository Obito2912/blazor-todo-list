@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using blazor_todo_list.Data
@using blazor_todo_list.Services

@inject IAccountService AccountService
@inject NavigationManager NavigationManager

<PageTitle>Create Account | My Quest</PageTitle>

<section class="auth-page">
    <div class="auth-card">
        <div class="auth-card__intro">
            <span class="auth-card__mark" aria-hidden="true">★</span>
            <h1>Start your quest.</h1>
            <p>Create your My Quest account to plan, focus, and track progress.</p>
        </div>

        <div class="auth-tabs">
            <a href="login">Sign In</a>
            <a href="register" class="active" aria-current="page">Create Account</a>
        </div>

        <div class="auth-panel">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger auth-alert" role="alert">@errorMessage</div>
            }

            <EditForm Model="Input" FormName="register" OnValidSubmit="HandleRegister" method="post">
                <DataAnnotationsValidator />

                <p class="auth-field-label">I AM JOINING AS A...</p>
                <InputRadioGroup @bind-Value="Input.Role" class="auth-role-group" role="radiogroup" aria-label="I am joining as a">
                    <label class="auth-role-option">
                        <InputRadio TValue="AccountRole" Value="AccountRole.Student" />
                        <span class="auth-role-option__card">
                            <span class="auth-role-option__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M22 10 12 5 2 10l10 5 10-5Z"></path><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"></path></svg>
                            </span>
                            <span><strong>Student</strong><small>Track my own quests</small></span>
                        </span>
                    </label>
                    <label class="auth-role-option">
                        <InputRadio TValue="AccountRole" Value="AccountRole.Teacher" />
                        <span class="auth-role-option__card">
                            <span class="auth-role-option__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path></svg>
                            </span>
                            <span><strong>Teacher</strong><small>Assign &amp; review quests</small></span>
                        </span>
                    </label>
                </InputRadioGroup>

                <div class="auth-field">
                    <label for="full-name">Full Name</label>
                    <InputText id="full-name" class="form-control" @bind-Value="Input.FullName" placeholder="Jane Doe" autocomplete="name" />
                    <ValidationMessage For="() => Input.FullName" />
                </div>

                <div class="auth-field">
                    <label for="email">Email Address</label>
                    <InputText id="email" class="form-control" @bind-Value="Input.Email" placeholder="you@example.com" autocomplete="username" />
                    <ValidationMessage For="() => Input.Email" />
                </div>

                <div class="auth-field">
                    <label for="password">Password</label>
                    <div class="auth-field-row">
                        <InputText id="password" type="@(showPassword ? "text" : "password")" class="form-control" @bind-Value="Input.Password" placeholder="Min. 6 characters" autocomplete="new-password" />
                        <button type="button" class="auth-toggle-visibility" aria-label="@(showPassword ? "Hide password" : "Show password")" @onclick="() => showPassword = !showPassword">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </button>
                    </div>
                    <ValidationMessage For="() => Input.Password" />
                </div>

                <div class="auth-field">
                    <label for="confirm-password">Confirm Password</label>
                    <InputText id="confirm-password" type="password" class="form-control" @bind-Value="Input.ConfirmPassword" placeholder="Re-enter your password" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>

                <button type="submit" class="btn btn-quest-primary auth-submit">Create Account</button>
            </EditForm>
        </div>

        <p class="auth-footnote">Already have an account? <a href="login">Sign in</a></p>
    </div>
</section>

@code {
    private string? errorMessage;
    private bool showPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private RegisterFormModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task HandleRegister()
    {
        var result = await AccountService.RegisterAsync(new RegisterRequest(
            Input.FullName.Trim(),
            Input.Email.Trim(),
            Input.Password,
            Input.Role));

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(ReturnUrl ?? "tasks");
            return;
        }

        errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class RegisterFormModel
    {
        [Required(ErrorMessage = "Enter your full name.")]
        [StringLength(120)]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a password.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public AccountRole Role { get; set; } = AccountRole.Student;
    }
}