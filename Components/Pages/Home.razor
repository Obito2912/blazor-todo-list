@page "/"

<PageTitle>My Quest</PageTitle>

<section class="home-intro">
    <div>
        <h1>Turn your plans into progress.</h1>
        <p>My Quest gives you a focused place to capture tasks, choose what matters, and keep moving.</p>
        <div class="home-intro__actions">
            <a class="btn btn-primary btn-lg" href="tasks">View my tasks</a>
            <a class="btn btn-outline-secondary btn-lg" href="tasks/new">Add a task</a>
        </div>
    </div>

    <div class="home-intro__panel" aria-label="How My Quest works">
        <h2>A simple daily rhythm</h2>
        <ol>
            <li><span>1</span><div><strong>Capture it</strong><small>Add the task before it slips away.</small></div></li>
            <li><span>2</span><div><strong>Find your focus</strong><small>Search and filter what needs attention.</small></div></li>
            <li><span>3</span><div><strong>Complete the quest</strong><small>Mark it done and move forward.</small></div></li>
        </ol>
    </div>
</section>
