@page "/forgot-password"

<PageTitle>Forgot Password | My Quest</PageTitle>

<section class="auth-page">
    <div class="auth-card">
        <div class="auth-card__intro">
            <span class="auth-card__mark" aria-hidden="true">★</span>
            <h1>Forgot your password?</h1>
            <p>No email service is connected yet for this project.</p>
        </div>

        <div class="auth-panel">
            <p>To reset your password right now, ask your teacher or the app administrator to reset
                it for you from the account records. Self-service email reset can be added later by
                wiring up an email sender in <code>AccountService</code>.</p>
            <a class="btn btn-outline-secondary auth-submit" href="login">Back to sign in</a>
        </div>
    </div>
</section>
