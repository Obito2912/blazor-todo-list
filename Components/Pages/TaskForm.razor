@page "/tasks/new"
@rendermode InteractiveServer
@inject ITaskService TaskService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@using System.Security.Claims

<PageTitle>@(TaskId.HasValue ? "Edit task" : "New task") | My Quest</PageTitle>

<section class="task-form-page" aria-labelledby="task-form-heading">
    <a class="back-link" href="tasks">← Back to tasks</a>
    <header>
        <h1 id="task-form-heading">@(TaskId.HasValue ? "Edit task" : "Create a task")</h1>
    </header>

    @if (!IsLoading)
    {
        <EditForm Model="FormValue" OnValidSubmit="HandleValidSubmit" FormName="task-form">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="form-label" for="task-title">Title</label>
                <InputText id="task-title" class="form-control" @bind-Value="FormValue.Title" maxlength="120" />
                <ValidationMessage For="() => FormValue.Title" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="task-description">Description</label>
                <InputTextArea id="task-description" class="form-control" @bind-Value="FormValue.Description" rows="5" maxlength="1000" />
                <ValidationMessage For="() => FormValue.Description" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="task-due-date">Due date</label>
                <InputDate id="task-due-date" class="form-control" @bind-Value="FormValue.DueDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }

            <div class="form-actions">
                <a class="btn btn-outline-secondary" href="tasks">Cancel</a>
                <button class="btn btn-primary" type="submit">Save task</button>
            </div>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "edit")]
    public int? TaskId { get; set; }

    private TaskFormValue FormValue { get; set; } = new();
    private string? userId;
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (TaskId.HasValue && userId is not null)
        {
            var existing = await TaskService.GetByIdAsync(userId, TaskId.Value);
            if (existing is not null)
            {
                FormValue = new TaskFormValue
                {
                    Title = existing.Title,
                    Description = existing.Description,
                    DueDate = existing.DueDate
                };
            }
        }

        IsLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        if (userId is null)
        {
            ErrorMessage = "You must be logged in to save a task.";
            return;
        }

        if (TaskId.HasValue)
        {
            var updated = await TaskService.UpdateAsync(userId, TaskId.Value, FormValue);
            if (updated is null)
            {
                ErrorMessage = "That task could not be found.";
                return;
            }
        }
        else
        {
            await TaskService.AddAsync(userId, FormValue);
        }

        Navigation.NavigateTo("tasks");
    }
}