<span class="user-avatar @CssClass" aria-label="Avatar for @Name">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl"
             alt=""
             referrerpolicy="no-referrer"
             onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
        <span class="user-avatar__initials" hidden>@Initials(Name)</span>
    }
    else
    {
        <span class="user-avatar__initials">@Initials(Name)</span>
    }
    @if (ShowStatus)
    {
        <i class="user-avatar__status" aria-hidden="true"></i>
    }
</span>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool ShowStatus { get; set; }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
